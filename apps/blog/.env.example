# Sanity
# Get these from https://www.sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Generate at sanity.io/manage → API → Tokens → "Viewer" role
SANITY_API_READ_TOKEN=

# Visual Editing (set to false in production)
PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true

# Site URL
PUBLIC_SITE_URL=http://localhost:4321

# Action Network
ACTION_NETWORK_API_KEY=

# Google Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# Google Sheets
GOOGLE_SHEETS_API_KEY=

# Mapbox Geocoding
MAPBOX_GEOCODER_TOKEN=

# --- Content submission flow (see docs/submission-flow.md) ---
# Local dev reads these via import.meta.env; in production set them with
# `wrangler secret put <NAME>`. D1/R2 are wrangler.jsonc bindings, not listed here.

# Session cookie signing key (generate: `openssl rand -base64 32`)
SESSION_SECRET=

# Discord OAuth + bot (currently STUBBED — leave blank until set up, see §10)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:4321/auth/discord/callback
DISCORD_ADMIN_WEBHOOK_URL=

# Turnstile (bot protection)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only if approving outside the Studio session (normally unused)
SANITY_WRITE_TOKEN=
