---
import { sanityClient } from "sanity:client"
import imageUrlBuilder from "@sanity/image-url"
import { PortableText as PortableTextInternal } from "astro-portabletext"
import { Button } from "@tidewater-dsa/ui/components/button"
import Layout from "@/layouts/main.astro"
import { loadQuery } from "@/lib/load-query"
import { HOME_PAGE_QUERY } from "@/sanity/queries"
import type { HOME_PAGE_QUERY_RESULT } from "@/sanity/types"
import PortableTextLink from "@/components/PortableTextLink.astro"

const { data } = await loadQuery<HOME_PAGE_QUERY_RESULT>({
  query: HOME_PAGE_QUERY,
})
const { home } = data

const builder = imageUrlBuilder(sanityClient)
function urlFor(source: any) {
  return builder.image(source)
}
---

<Layout title="Home | Tidewater DSA">
  <section class="mx-auto max-w-5xl px-6 pt-10 pb-4">
    <div class="mx-auto max-w-3xl space-y-3 text-center">
      <h1
        class="text-4xl font-extrabold tracking-tight text-foreground md:text-5xl lg:text-6xl"
      >
        {home?.heroHeadline}
      </h1>
      {
        home?.heroSubheadline && (
          <p class="mx-auto max-w-xl text-lg text-muted-foreground">
            {home.heroSubheadline}
          </p>
        )
      }
      {
        home?.heroCtaText && (
          <div class="pt-2">
            <a href={home.heroCtaLink || "#"}>
              <Button
                size="lg"
                className="h-11 cursor-pointer px-8 font-semibold"
              >
                {home.heroCtaText}
              </Button>
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    home?.heroImage && (
      <section class="mx-auto max-w-5xl px-6 pb-8">
        <div class="overflow-hidden rounded-2xl shadow-lg">
          <img
            src={urlFor(home.heroImage).width(1200).quality(80).url()}
            alt={home?.heroHeadline || "Tidewater DSA"}
            class="w-full object-cover"
          />
        </div>
      </section>
    )
  }

  {
    home?.body && (
      <section class="mx-auto max-w-3xl px-6 py-12">
        <article class="mx-auto prose prose-lg max-w-none dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-p:text-muted-foreground prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl">
          <PortableTextInternal
            value={home.body}
            components={{
              mark: {
                link: PortableTextLink,
              },
            }}
          />
        </article>
      </section>
    )
  }
</Layout>
