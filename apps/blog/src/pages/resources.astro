---
import Layout from "@/layouts/main.astro"
import RichText from "@/components/RichText.astro"
import { CommunityResources } from "@/components/resources/CommunityResources"
import { loadQuery } from "@/lib/load-query"
import { RESOURCES_PAGE_QUERY } from "@/sanity/queries"
import type { RESOURCES_PAGE_QUERY_RESULT } from "@/sanity/types"
import { fetchSheetValues, SheetsFetchError } from "@/lib/google-sheets"
import { parseResourceRows } from "@/lib/resources"
import { geocodeResources } from "@/lib/geocode"
import {
  createKvGeocodeCache,
  createMemoryGeocodeCache,
} from "@/lib/geocode-cache"
import type { Resource, ResourcesMeta } from "@/types"
import { stripStega } from "@/lib/stega"
import "@/styles/print-resources.css"

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, stale-while-revalidate=3600"
)

const { data } = await loadQuery<RESOURCES_PAGE_QUERY_RESULT>({
  query: RESOURCES_PAGE_QUERY,
})

const pageData = data?.page

const pageTitle = pageData?.title ?? "Resources"
const pageBody = pageData?.body ?? null
const memberHeadline = pageData?.memberHeadline ?? "Member Resources"
const communityHeadline = pageData?.communityHeadline ?? "Community Resources"
const communityIntro = pageData?.communityIntro ?? null
const disclaimerText =
  pageData?.disclaimerText ??
  "Resources change. Please verify details directly with each organization before visiting."
const printFooterText =
  pageData?.printFooterText ??
  "Resources compiled by Tidewater DSA. Verify details before visiting. Data may change. Visit our website for the latest."

const spreadsheetId = stripStega((pageData?.googleSheetId ?? "").trim())
const range = stripStega((pageData?.googleSheetRange ?? "").trim()) || "A:X"
const apiKey = import.meta.env.GOOGLE_SHEETS_API_KEY || ""
const mapboxToken = import.meta.env.MAPBOX_GEOCODER_TOKEN || ""

const view = Astro.url.searchParams.get("view") === "map" ? "map" : "grid"

let resources: Resource[] = []
let meta: ResourcesMeta | null = null
let resourcesError: string | null = null

if (!spreadsheetId) {
  resourcesError =
    "No Google Sheet configured. An admin should set the Sheet ID in Sanity (Resources Page → Data Source)."
} else if (!apiKey) {
  resourcesError =
    "No Google Sheets API key configured. Contact a site admin to set GOOGLE_SHEETS_API_KEY."
} else {
  try {
    const rows = await fetchSheetValues({ spreadsheetId, range, apiKey })
    resources = parseResourceRows(rows)

    const kv = Astro.locals.runtime?.env.GEOCODE_CACHE
    const cache = kv ? createKvGeocodeCache(kv) : createMemoryGeocodeCache()

    await geocodeResources(resources, {
      mapboxToken,
      cache,
      timeoutMs: 6000,
      maxLookups: 100,
    })

    meta = {
      fetchedAt: new Date().toISOString(),
      totalCount: resources.length,
      withAddressCount: resources.filter((r) => r.fullAddress).length,
      geocodedCount: resources.filter((r) => r.coords).length,
      sourceSheetId: spreadsheetId,
      sourceRange: range,
    }
  } catch (err) {
    if (err instanceof SheetsFetchError) {
      resourcesError = `Sheets API error (${err.status}): ${err.message}`
    } else {
      resourcesError =
        err instanceof Error
          ? err.message
          : "Unknown error fetching resources from Google Sheets."
    }
  }
}
---

<Layout title={pageTitle}>
  <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {pageTitle}
      </h1>
    </header>

    {
      pageBody && (
        <section
          id="member-resources"
          aria-labelledby="member-resources-heading"
        >
          <div class="mb-6 border-t border-primary/20 pt-10">
            <div class="mb-1 h-1 w-16 bg-primary" />
            <h2
              id="member-resources-heading"
              class="text-3xl font-extrabold tracking-tight text-primary uppercase"
            >
              {memberHeadline}
            </h2>
          </div>
          <div class="mb-16">
            <RichText value={pageBody} />
          </div>
        </section>
      )
    }

    <section
      id="community-resources"
      aria-labelledby="community-resources-heading"
    >
      <div class="mb-6 border-t border-primary/20 pt-10">
        <div class="mb-1 h-1 w-16 bg-primary"></div>
        <h2
          id="community-resources-heading"
          class="text-3xl font-extrabold tracking-tight text-primary uppercase"
        >
          {communityHeadline}
        </h2>
        {
          communityIntro && (
            <p class="mt-3 max-w-3xl text-lg text-muted-foreground">
              {communityIntro}
            </p>
          )
        }
      </div>

      <CommunityResources
        client:load
        resources={resources}
        meta={meta}
        error={resourcesError}
        initialView={view}
        disclaimerText={disclaimerText}
        printFooterText={printFooterText}
        communityHeadline={communityHeadline}
      />
    </section>
  </main>
</Layout>
