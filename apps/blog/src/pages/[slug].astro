---
import Layout from "@/layouts/main.astro"
import { loadQuery } from "@/lib/load-query"
import { PAGE_BY_SLUG_QUERY } from "@/sanity/queries"
import type { PAGE_BY_SLUG_QUERY_RESULT } from "@/sanity/types"
import RichText from "@/components/RichText.astro"

const { slug } = Astro.params
if (!slug) return new Response(null, { status: 404 })

const { data } = await loadQuery<PAGE_BY_SLUG_QUERY_RESULT>({
  query: PAGE_BY_SLUG_QUERY,
  params: { slug },
})

if (!data.page) return new Response(null, { status: 404 })

const { page, settings } = data
---

<Layout title={`${page.title} | ${settings?.siteTitle || "Tidewater DSA"}`}>
  <main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {page.title}
      </h1>
    </header>

    <div class="mx-auto w-full max-w-4xl">
      <RichText value={page.body ?? []} />
    </div>
  </main>
</Layout>
