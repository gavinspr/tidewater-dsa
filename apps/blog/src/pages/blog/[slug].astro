---
import Layout from "@/layouts/main.astro"
import RichText from "@/components/rich-text/RichText.astro"
import Cover from "@/components/blog/Cover.astro"
import CategoryChip from "@/components/blog/CategoryChip.astro"
import PostCard from "@/components/blog/PostCard.astro"
import { loadQuery } from "@/lib/load-query"
import { POST_BY_SLUG_QUERY } from "@/sanity/queries"
import type { POST_BY_SLUG_QUERY_RESULT } from "@/sanity/types"
import { formatDate, posterVariant } from "@/lib/blog"
import { estimateReadingTime } from "@/lib/reading-time"

const { slug } = Astro.params
if (!slug) return new Response(null, { status: 404 })

const { data } = await loadQuery<POST_BY_SLUG_QUERY_RESULT>({
  query: POST_BY_SLUG_QUERY,
  params: { slug },
})

const post = data?.post
if (!post) return new Response(null, { status: 404 })

const cover = post.coverImage
const hasCover = Boolean(cover?.asset)
const readingMinutes = estimateReadingTime(post.body)
const initials = (post.author ?? "")
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase()
const related = post.related ?? []
---

<Layout title={post.title ?? undefined} showSignup={true}>
  <article class="mx-auto max-w-7xl px-5 py-8 sm:px-6 md:py-12">
    <!-- Breadcrumb -->
    <div class="mono-eyebrow-sm flex items-center gap-2 text-muted-foreground">
      <a href="/blog" class="transition-colors hover:text-primary">← Dispatches</a>
      <span>/</span>
      <span>{post.category?.title}</span>
    </div>

    <!-- Header -->
    <header class="mt-4 border-t-2 border-foreground pt-6">
      <CategoryChip title={post.category?.title} solid />
      <h1 class="heading-display mt-4 max-w-[20ch] text-[clamp(2.4rem,6.6vw,5rem)]">
        {post.title}
      </h1>
      {
        post.dek && (
          <p class="mt-5 max-w-[52ch] text-[clamp(1.15rem,2.6vw,1.45rem)] leading-snug text-foreground-soft">
            {post.dek}
          </p>
        )
      }

      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4 border-y border-border py-4">
        <div class="flex items-center gap-3">
          <div
            class="grid h-11 w-11 place-items-center bg-primary font-heading text-base font-black text-primary-foreground"
            aria-hidden="true"
          >
            {initials}
          </div>
          <div class="leading-tight">
            <div class="font-medium">{post.author}</div>
            {
              post.authorRole && (
                <div class="mono-eyebrow-sm text-muted-foreground">{post.authorRole}</div>
              )
            }
          </div>
        </div>
        <div class="mono-eyebrow-sm flex flex-wrap gap-x-4 gap-y-1 text-muted-foreground tabular-nums">
          <span>{formatDate(post.publishedAt)}</span>
          <span aria-hidden="true">✦</span>
          <span>{readingMinutes} min read</span>
        </div>
      </div>
    </header>

    <!-- Cover -->
    <figure class="mt-8 md:mt-10">
      <div class="aspect-[21/9] overflow-hidden">
        <Cover
          image={cover}
          tag={post.category?.title}
          variant={posterVariant(post.category?.slug)}
          width={1600}
          height={686}
          loading="eager"
          sizes="(max-width: 1220px) 100vw, 1220px"
        />
      </div>
      {
        hasCover && (cover?.caption || cover?.credit) && (
          <figcaption class="mono-eyebrow-sm mt-3 flex flex-wrap gap-x-3 gap-y-1 text-muted-foreground">
            {cover?.caption && <span>{cover.caption}</span>}
            {cover?.credit && <span class="text-foreground-soft">Photo — {cover.credit}</span>}
          </figcaption>
        )
      }
    </figure>

    <!-- Body -->
    <div class="mx-auto mt-10 max-w-readable md:mt-14">
      <RichText value={post.body ?? []} dropCap />
    </div>

    <!-- End matter -->
    <div class="mx-auto mt-10 max-w-readable">
      {
        post.tags && post.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 border-t-2 border-foreground pt-6">
            {post.tags.map((tag) => (
              <a
                href={`/blog?tag=${encodeURIComponent(tag)}`}
                class="mono-eyebrow-sm border border-border px-2.5 py-1.5 text-foreground-soft transition-colors hover:border-primary hover:text-primary"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }

      <div class="editorial-panel mt-8 flex items-start gap-3 p-4">
        <span class="text-lg leading-relaxed text-primary" aria-hidden="true">✦</span>
        <p class="text-sm text-foreground-soft">
          <b class="text-foreground">Written by a chapter member.</b> Dispatches publishes
          member-submitted words and analysis. Want to write for us?
          <a href="/submit" class="text-primary underline underline-offset-2">Submit a draft →</a>
        </p>
      </div>
    </div>

    <!-- Related -->
    {
      related.length > 0 && (
        <section class="mt-16 md:mt-24">
          <div class="flex flex-wrap items-baseline justify-between gap-4 border-t-2 border-foreground pt-4">
            <h2 class="heading-display text-[clamp(1.5rem,3.5vw,2.1rem)]">More Dispatches</h2>
            <a href="/blog" class="mono-eyebrow text-primary transition-colors hover:opacity-70">
              All dispatches →
            </a>
          </div>
          <div class="mt-8 grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-3">
            {related.map((rel) => (
              <PostCard post={rel} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>
