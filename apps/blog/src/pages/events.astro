---
import { addMonths, endOfMonth, startOfMonth, subMonths } from "date-fns"
import Layout from "@/layouts/main.astro"
import { EventCalendar } from "@/components/calendar/EventCalendar"
import { getEvents } from "@/lib/events"
import {
  EVENTS_PAGE_QUERY,
  EVENT_TYPES_QUERY,
  WORKING_GROUPS_QUERY,
} from "@/sanity/queries"
import type {
  EVENTS_PAGE_QUERY_RESULT,
  EVENT_TYPES_QUERY_RESULT,
  WORKING_GROUPS_QUERY_RESULT,
} from "@/sanity/types"
import type { SerializedEvent } from "@/types"
import { loadQuery } from "@/lib/load-query"

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, stale-while-revalidate=600"
)

// Fetch window: 1 month back, 4 months forward
const now = new Date()
const rangeStart = startOfMonth(subMonths(now, 1))
const rangeEnd = endOfMonth(addMonths(now, 3))

let events: SerializedEvent[] = []
let error: string | null = null
let pageData: EVENTS_PAGE_QUERY_RESULT["page"] = null
let eventTypes: EVENT_TYPES_QUERY_RESULT = []
let workingGroups: WORKING_GROUPS_QUERY_RESULT = []

try {
  const [eventsResult, pageResult, typesResult, groupsResult] =
    await Promise.all([
      getEvents({ rangeStart, rangeEnd }),
      loadQuery<EVENTS_PAGE_QUERY_RESULT>({ query: EVENTS_PAGE_QUERY }),
      loadQuery<EVENT_TYPES_QUERY_RESULT>({ query: EVENT_TYPES_QUERY }),
      loadQuery<WORKING_GROUPS_QUERY_RESULT>({ query: WORKING_GROUPS_QUERY }),
    ])

  events = eventsResult
  pageData = pageResult.data.page
  eventTypes = typesResult.data ?? []
  workingGroups = groupsResult.data ?? []
} catch (err) {
  error = err instanceof Error ? err.message : "Unknown error"
}

const pageTitle = pageData?.title ?? "Events"
const noFeaturedEventsMessage = pageData?.noFeaturedEventsMessage ?? undefined
---

<Layout title={pageTitle}>
  <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {pageTitle}
      </h1>
    </header>

    <EventCalendar
      client:load
      events={events}
      eventTypes={eventTypes}
      workingGroups={workingGroups}
      error={error}
      noFeaturedEventsMessage={noFeaturedEventsMessage}
    />
  </main>
</Layout>
