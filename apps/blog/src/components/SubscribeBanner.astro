---
import { NewsletterDialog } from "./NewsletterDialog"

interface Props {
  headline?: string
  description?: string
}

const {
  headline = "Stay Updated",
  description = "Get the latest on meetings, events, and actions in the 757 — straight to your inbox.",
} = Astro.props
---

<section class="border-t border-border/50">
  <div
    class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-6 py-16 text-center md:flex-row md:justify-between md:gap-8 md:text-left"
  >
    <div class="space-y-2">
      <h2 class="text-2xl font-bold tracking-tight">{headline}</h2>
      <p class="max-w-md text-muted-foreground">{description}</p>
    </div>
    <div class="shrink-0">
      <NewsletterDialog client:load />
    </div>
  </div>
</section>