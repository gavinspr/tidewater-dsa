---
import { MobileNav } from "./MobileNav"
import { Button } from "@tidewater-dsa/ui/components/button"
import { HeartIcon } from "lucide-react"
import type { Settings, ValidNavLink } from "@/types"

interface Props {
  logoUrl: string | null
  title: string
  navLinks: Settings["navLinks"]
  callToActionText: Settings["callToActionText"]
  callToActionLink: Settings["callToActionLink"]
}

const { logoUrl, title, navLinks, callToActionText, callToActionLink } =
  Astro.props

const validNavLinks =
  navLinks?.filter((link): link is ValidNavLink =>
    Boolean(link.title && link.slug)
  ) ?? []
---

<header
  class="sticky top-0 z-50 border-b border-border/50 bg-card/95 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-340 items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="flex items-center gap-3 transition-opacity hover:opacity-80"
    >
      {
        logoUrl && (
          <img
            src={logoUrl}
            alt={title || "Site Logo"}
            class="h-14 w-auto shrink-0 rounded-lg object-contain sm:h-16"
          />
        )
      }
    </a>

    <nav class="hidden shrink-0 items-center gap-8 lg:flex">
      {
        validNavLinks.map((link) => (
          <a
            href={`/${link.slug}`}
            class="font-semibold text-foreground/80 transition-colors hover:text-primary"
          >
            {link.title}
          </a>
        ))
      }

      {
        callToActionLink && callToActionText && (
          <a
            href={callToActionLink}
            target="_blank"
            rel="noreferrer"
            class="mb-0.5 ml-2"
          >
            <Button size="sm" className="cursor-pointer gap-1.5 font-bold">
              <HeartIcon fill="currentColor" />
              {callToActionText}
            </Button>
          </a>
        )
      }
    </nav>

    <div class="flex items-center gap-3 lg:hidden">
      {
        callToActionLink && callToActionText && (
          <a href={callToActionLink} target="_blank" rel="noreferrer">
            <Button
              size="sm"
              className="cursor-pointer gap-1.5 text-xs font-semibold"
            >
              <HeartIcon className="size-3" fill="currentColor" />
              {callToActionText}
            </Button>
          </a>
        )
      }
      <MobileNav client:load navLinks={validNavLinks} />
    </div>
  </div>
</header>
