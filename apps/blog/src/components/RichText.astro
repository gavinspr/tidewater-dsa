---
import { PortableText as PortableTextInternal } from "astro-portabletext"
import PortableTextLink from "@/components/PortableTextLink.astro"
import PortableTextImage from "@/components/PortableTextImage.astro"
import type { PortableTextBlock } from "sanity"

interface Props {
  value: PortableTextBlock[]
}

const { value } = Astro.props
---

<article
  class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-p:text-lg prose-p:text-muted-foreground prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-xl"
>
  <PortableTextInternal
    value={value ?? []}
    components={{
      type: {
        image: PortableTextImage,
      },
      mark: {
        link: PortableTextLink,
      },
    }}
  />
</article>
